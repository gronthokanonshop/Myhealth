{
  "rules": {
    ".read": false,
    ".write": false,

    "products": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'"
    },

    "banners": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'"
    },

    "categoryImages": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'"
    },

    "heroImage": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'"
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'"
    },

    "categories": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'"
    },

    "aiConfig": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'"
    },

    "aiLogs": {
      ".read": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      "$logId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['q','ts'])",
        "q":        { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
        "ts":       { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "mode":     { ".validate": "newData.isString() && newData.val().length <= 20" },
        "products": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "$other":   { ".validate": false }
      }
    },

    "posts": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'"
    },

    "notices": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'"
    },

    "messages": {
      ".read": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      "$msgId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name','phone','message','ts'])",
        "name":    { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "phone":   { ".validate": "newData.isString() && newData.val().matches(/^01[0-9]{9}$/)" },
        "email":   { ".validate": "newData.isString() && newData.val().length <= 100" },
        "subject": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "message": { ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 1500" },
        "ts":      { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "read":    { ".validate": "newData.isBoolean() && auth != null && auth.token.email === 'mijanu443@gmail.com'" },
        "$other":  { ".validate": false }
      }
    },

    "stockAlerts": {
      ".read": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      "$pid": {
        ".validate": "$pid.matches(/^[0-9]{1,12}$/)",
        "$alertId": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['phone','ts'])",
          "phone":  { ".validate": "newData.isString() && newData.val().matches(/^01[0-9]{9}$/)" },
          "ts":     { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "$other": { ".validate": false }
        }
      }
    },

    "recentSales": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['d','p','ts'])",
        "d":      { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z' .-]{2,40}$/)" },
        "p":      { ".validate": "newData.isNumber()" },
        "ts":     { ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 600000" },
        "$other": { ".validate": false }
      }
    },

    "coupons": {
      ".read": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      "$code": {
        ".read": true
      }
    },

    "subscribers": {
      ".read": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      "$subId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['email','ts'])",
        "email": { ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 100 && newData.val().contains('@')" },
        "ts":    { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    },

    "orders": {
      ".read": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      ".indexOn": ["placedAt", "status"],
      "$orderId": {
        ".read": true,
        ".write": "(!data.exists() && newData.exists() && newData.child('status').val() === 'pending' && !newData.child('paymentStatus').exists() && !newData.child('adminNote').exists() && !newData.child('tracking_code').exists() && !newData.child('consignment_id').exists() && !newData.child('statusHistory').exists()) || (auth != null && auth.token.email === 'mijanu443@gmail.com')",
        ".validate": "$orderId.matches(/^MH[0-9A-Z]+$/) && $orderId.length <= 24 && newData.hasChildren(['id','items','customer','total','status','placedAt']) && newData.child('id').val() === $orderId && newData.child('items').hasChildren()",
        "customer": {
          ".validate": "newData.hasChildren(['name','phone','address'])",
          "name":    { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "phone":   { ".validate": "newData.isString() && newData.val().matches(/^01[0-9]{9}$/)" },
          "address": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
          "$other":  { ".validate": "newData.isString() && newData.val().length <= 300" }
        },
        "items": {
          "$i": {
            ".validate": "newData.hasChildren(['name','qty','price'])",
            "id":    { ".validate": "newData.isNumber()" },
            "name":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
            "qty":   { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999" },
            "price": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        },
        "status":   { ".validate": "newData.isString() && newData.val().matches(/^(pending|confirmed|shipped|delivered|cancelled|returned)$/)" },
        "payment":  { ".validate": "newData.isString() && newData.val().length <= 20" },
        "paymentInfo": {
          "trxId":  { ".validate": "newData.isString() && newData.val().length <= 40" },
          "sender": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "$other": { ".validate": false }
        },
        "placedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "coupon":   { ".validate": "newData.isString() && newData.val().length <= 30" },
        "uid":      { ".validate": "newData.isString() && newData.val().length <= 128" },
        "total":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "subtotal": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "discount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "delivery": { ".validate": "newData.isNumber() && newData.val() >= 0" }
      }
    },

    "reviews": {
      ".read": true,
      "$productId": {
        ".validate": "$productId.matches(/^[0-9]+$/)",
        "$reviewId": {
          ".write": "(!data.exists() && newData.hasChildren(['name','rating','text','ts'])) || (auth != null && auth.token.email === 'mijanu443@gmail.com')",
          "name":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "rating": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
          "text":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
          "ts":     { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "$other": { ".validate": false }
        }
      }
    },

    "couriers": {
      ".read": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'"
    },

    "pickups": {
      ".read": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'"
    },

    "adminConfig": {
      ".read": "auth != null && auth.token.email === 'mijanu443@gmail.com'",
      ".write": "auth != null && auth.token.email === 'mijanu443@gmail.com'"
    },

    "users": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || auth.token.email === 'mijanu443@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'mijanu443@gmail.com')",
        "name":     { ".validate": "newData.isString() && newData.val().length <= 100" },
        "phone":    { ".validate": "newData.isString() && newData.val().length <= 20" },
        "address":  { ".validate": "newData.isString() && newData.val().length <= 500" },
        "email":    { ".validate": "newData.isString() && newData.val().length <= 100" },
        "division": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "district": { ".validate": "newData.isString() && newData.val().length <= 40" }
      }
    }
  }
}
